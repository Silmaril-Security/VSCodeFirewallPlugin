{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "\"${PLUGIN_ROOT}/scripts/run-hook.sh\" dispatch sessionStart",
        "timeoutSec": 12
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "command": "\"${PLUGIN_ROOT}/scripts/run-hook.sh\" dispatch userPromptSubmitted",
        "timeoutSec": 12
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "command": "\"${PLUGIN_ROOT}/scripts/run-hook.sh\" dispatch preToolUse",
        "timeoutSec": 12
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "command": "\"${PLUGIN_ROOT}/scripts/run-hook.sh\" dispatch postToolUse",
        "timeoutSec": 12
      }
    ]
  }
}

